
-- Zone Teleporter | Steal An Egg
-- Panel visual para Roblox Lua

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "ZoneTeleporter"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(280, 190)
main.Position = UDim2.new(0.5, -140, 0.5, -95)
main.BackgroundColor3 = Color3.fromRGB(25, 22, 38)
main.Parent = gui

Instance.new("UICorner", main).CornerRadius =
    UDim.new(0, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -45, 0, 42)
title.Position = UDim2.fromOffset(12, 4)
title.BackgroundTransparency = 1
title.Text = "🌎 Zone Teleporter"
title.TextColor3 = Color3.fromRGB(195, 145, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.Parent = main

local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(30, 30)
close.Position = UDim2.new(1, -38, 0, 8)
close.Text = "X"
close.TextColor3 = Color3.new(1, 1, 1)
close.BackgroundColor3 = Color3.fromRGB(140, 45, 65)
close.Parent = main

close.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

local function makeButton(text, y, color, destination)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -24, 0, 48)
    button.Position = UDim2.fromOffset(12, y)
    button.Text = text
    button.TextColor3 = Color3.new(1, 1, 1)
    button.BackgroundColor3 = color
    button.Font = Enum.Font.GothamBold
    button.TextSize = 15
    button.Parent = main

    Instance.new("UICorner", button).CornerRadius =
        UDim.new(0, 8)

    button.MouseButton1Click:Connect(function()
        local character = player.Character
        local root = character and
            character:FindFirstChild("HumanoidRootPart")

        if root and destination then
            root.CFrame = CFrame.new(
                destination.X,
                destination.Y,
                destination.Z
            )
        end
    end)
end

-- REEMPLAZA estas coordenadas por las ubicaciones reales.
makeButton(
    "🏠 Zona principal",
    55,
    Color3.fromRGB(65, 125, 190),
    Vector3.new(0, 10, 0)
)

makeButton(
    "🚀 Zona final",
    112,
    Color3.fromRGB(125, 65, 190),
    Vector3.new(100, 10, 100)
)
